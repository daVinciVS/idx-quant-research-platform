# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables, secrets, and credentials
.env
.env.*
!.env.example
secrets/
credentials/
*.pem
*.key
service_account*.json

# Jupyter
.ipynb_checkpoints/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs and temporary files
*.log
logs/
tmp/
temp/

# Generated application artifacts
cache/
output/
outputs/
reports/
generated/
downloads/

# All local data is private by default
/data/*

# Re-include only the public, reproducible demo-data path
!/data/demo/
!/data/demo/**

# Private/local market data and personal portfolio data
/data/raw/
/data/manual/
/data/private/
/data/cache/
/data/portfolio/
/data/watchlists/

# Exported analysis files are generated by default
*.xlsx
*.xls
*.pdf

# Allow intentionally curated public samples only
!docs/
!docs/samples/
!docs/samples/**

# Local archives and historical backup scripts
*.zip
*_before_*.py
README.txt